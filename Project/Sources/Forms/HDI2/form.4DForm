				"Text25": {
					"type": "text",
					"text": "WHAT IS \"APPLE WRITING TOOLS\"?",
					"top": 250,
					"left": 238,
					"width": 347,
					"height": 22,
					"fontWeight": "bold",
					"fontSize": 18,
					"stroke": "#459E63",
					"fontFamily": "Arial"
				},
				"Text23": {
					"type": "text",
					"text": "A suite of on device AI capabilities that let you summarize, rewrite, proofread, extract key points, and more, directly where you're typing: no copy-pasting, no switching between applications, and no interruption to your writing flow.",
					"top": 288,
					"left": 238,
					"width": 617,
					"height": 77,
					"fontFamily": "Arial",
					"fontSize": 13
				},
				"Rectangle12": {
					"type": "rectangle",
					"top": 378,
					"left": 117,
					"width": 770,
					"height": 139,
					"fill": "#F4F9FE",
					"borderRadius": 15,
					"stroke": "#247CD3"
				},
				"Text26": {
					"type": "text",
					"text": "WHAT DOES THIS FEATURE BRING?",
					"top": 402,
					"left": 238,
					"width": 400,
					"height": 22,
					"fontWeight": "bold",
					"fontSize": 18,
					"stroke": "#247CD3",
					"fontFamily": "Arial"
				},
				"Text27": {
					"type": "text",
					"text": "Starting 4D 21 R4, you can tap into the full power of the Apple Writing Tools directly inside your 4D applications, all with a simple right-click in a text input or a 4D Write Pro area, or by invoking the new standard action writingTools.",
					"top": 440,
					"left": 238,
					"width": 649,
					"height": 77,
					"fontFamily": "Arial",
					"fontSize": 13
				},
				"Rectangle13": {
					"type": "rectangle",
					"top": 530,
					"left": 117,
					"width": 770,
					"height": 139,
					"fill": "#F9F7FB",
					"borderRadius": 15,
					"stroke": "#9F7BD9"
				},
				"Text28": {
					"type": "text",
					"text": "WHAT TO EXPECT IN THIS HDI?",
					"top": 554,
					"left": 238,
					"width": 287,
					"height": 22,
					"fontWeight": "bold",
					"fontSize": 18,
					"stroke": "#9F7BD9",
					"fontFamily": "Arial"
				},
				"Text29": {
					"type": "text",
					"text": "In the next tabs you will learn:\r- About the system requirements needed to use Apple Writing Tools\r- How to invoke Writing Tools using the contextual menu or the new standard action called \"writingTools\"",
					"top": 592,
					"left": 238,
					"width": 649,
					"height": 77,
					"fontFamily": "Arial",
					"fontSize": 13
				},
