					"height": 45,
					"fontFamily": "Arial",
					"fontSize": 13
				},
				"Text6": {
					"type": "text",
					"text": "English, Danish, Dutch, French, German, Italian, Norwegian, Portuguese, Spanish, Swedish, Turkish, Chinese (Simplified), Chinese (Traditional), Japanese, Korean, and Vietnamese.",
